{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/accounts",
      "destination": "/accounts.html"
    },
    {
      "source": "/clusters",
      "destination": "/clusters.html"
    },
    {
      "source": "/evaluation",
      "destination": "/evaluation.html"
    },
    {
      "source": "/methodology",
      "destination": "/methodology.html"
    }
  ]
}
